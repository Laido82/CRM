package components

templ Base(title, iconPath string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link href="/static/css/output.css" rel="stylesheet"/>
			<link rel="icon" type="image/png" href={ iconPath }/>
			<script src="/static/htmx/htmx.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
